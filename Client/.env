# =============================================================================
# BMC-Link Client Environment Configuration
# =============================================================================
# Note: In Vite, only variables prefixed with VITE_ are exposed to client code.
# =============================================================================

# Backend API Server Base URL
# - Local Development: uses .env.development (http://localhost:4800)
# - Production (Vercel): Leave empty so requests route through Vercel rewrites proxy
VITE_API_URL=
